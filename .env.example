# ── Google Gemini ──────────────────────────────────────────────────────────────
# Obtener en: https://aistudio.google.com/app/apikey
# Sin NEXT_PUBLIC_ — solo se usa en el servidor (Server Action)
GEMINI_API_KEY=AIza...

# ── Supabase (cliente público — seguro exponer en el navegador) ───────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Supabase (solo servidor — NUNCA exponer al navegador) ────────────────────
# Usada por la Server Action para borrar archivos del bucket "temporales"
SUPABASE_SERVICE_ROLE_KEY=eyJ...
